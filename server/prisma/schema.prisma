generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

model Customer {
  id               String    @id @default(uuid()) @db.UniqueIdentifier
  genesisId        String    @unique @db.VarChar(100)
  genesisAuthToken String    @db.VarChar(255)
  customerName     String?   @db.NVarChar(255)
  createdAt        DateTime  @default(now())
  createdBy        String?   @db.UniqueIdentifier
  modifiedAt       DateTime? @updatedAt
  modifiedBy       String?   @db.UniqueIdentifier

  integrations CustomerIntegration[]
  credentials  ConnectionCredential[]
  dataSyncs    DataSyncCredential[]
  schedules    ScheduleCredential[]
}

model IntegrationsCatalog {
  id             String  @id @db.VarChar(50)
  name           String  @db.NVarChar(100)
  category       String  @db.NVarChar(50)
  iconUrl        String? @db.VarChar(500)
  badge          String? @db.NVarChar(50)
  isGlobalActive Boolean @default(true)
  // Planned but not released: shown with a "Coming soon" ribbon, cannot be opened
  isComingSoon   Boolean @default(false)

  // Stamps (see prisma/sql/2026-10-28_admin_console.sql). *By = AdminUser.id, null = system/customer/old data
  createdAt  DateTime? @default(now())
  createdBy  String?   @db.UniqueIdentifier
  modifiedAt DateTime? @updatedAt
  modifiedBy String?   @db.UniqueIdentifier

  customers   CustomerIntegration[]
  sourceInfos IntegrationSourceInfo[]
  credentials ConnectionCredential[]
  dataSyncs   DataSyncCredential[]
  schedules   ScheduleCredential[]
}

// Per-source (GF / FLQ) display overrides. Null fields fall back to IntegrationsCatalog.
// isActive = false hides the integration for that source.
model IntegrationSourceInfo {
  integrationId String  @db.VarChar(50)
  source        String  @db.VarChar(10)
  name          String? @db.NVarChar(100)
  category      String? @db.NVarChar(50)
  iconUrl       String? @db.VarChar(500)
  badge         String? @db.NVarChar(50)
  isActive      Boolean @default(true)

  // Stamps (see prisma/sql/2026-10-28_admin_console.sql). *By = AdminUser.id, null = system/customer/old data
  createdAt  DateTime? @default(now())
  createdBy  String?   @db.UniqueIdentifier
  modifiedAt DateTime? @updatedAt
  modifiedBy String?   @db.UniqueIdentifier

  integration IntegrationsCatalog @relation(fields: [integrationId], references: [id])

  @@id([integrationId, source])
}

model CustomerIntegration {
  customerId    String  @db.UniqueIdentifier
  integrationId String  @db.VarChar(50)
  isEnabled     Boolean @default(false)
  isConfigured  Boolean @default(false)

  // Stamps (see prisma/sql/2026-10-28_admin_console.sql). *By = AdminUser.id, null = system/customer/old data
  createdAt  DateTime? @default(now())
  createdBy  String?   @db.UniqueIdentifier
  modifiedAt DateTime? @updatedAt
  modifiedBy String?   @db.UniqueIdentifier

  customer    Customer            @relation(fields: [customerId], references: [id])
  integration IntegrationsCatalog @relation(fields: [integrationId], references: [id])

  @@id([customerId, integrationId]) // Composite Primary Key
}

model ConnectionCredential {
  id            String    @id @default(uuid()) @db.UniqueIdentifier
  customerId    String    @db.UniqueIdentifier
  integrationId String    @db.VarChar(50)
  configPayload String    @db.NVarChar(Max)
  createdAt     DateTime? @default(now())
  createdBy     String?   @db.UniqueIdentifier
  modifiedAt    DateTime? @updatedAt
  modifiedBy    String?   @db.UniqueIdentifier

  customer    Customer            @relation(fields: [customerId], references: [id])
  integration IntegrationsCatalog @relation(fields: [integrationId], references: [id])
}

// Wizard step 3: data sync settings (JSON, same shape as ConnectionCredential)
model DataSyncCredential {
  id            String    @id @default(uuid()) @db.UniqueIdentifier
  customerId    String    @db.UniqueIdentifier
  integrationId String    @db.VarChar(50)
  configPayload String    @db.NVarChar(Max)
  createdAt     DateTime? @default(now())
  createdBy     String?   @db.UniqueIdentifier
  modifiedAt    DateTime? @updatedAt
  modifiedBy    String?   @db.UniqueIdentifier

  customer    Customer            @relation(fields: [customerId], references: [id])
  integration IntegrationsCatalog @relation(fields: [integrationId], references: [id])

  @@unique([customerId, integrationId])
}

// Wizard step 4: schedule settings (JSON, same shape as ConnectionCredential)
model ScheduleCredential {
  id            String    @id @default(uuid()) @db.UniqueIdentifier
  customerId    String    @db.UniqueIdentifier
  integrationId String    @db.VarChar(50)
  configPayload String    @db.NVarChar(Max)
  createdAt     DateTime? @default(now())
  createdBy     String?   @db.UniqueIdentifier
  modifiedAt    DateTime? @updatedAt
  modifiedBy    String?   @db.UniqueIdentifier

  customer    Customer            @relation(fields: [customerId], references: [id])
  integration IntegrationsCatalog @relation(fields: [integrationId], references: [id])

  @@unique([customerId, integrationId])
}

// Console users (/admin). Every active admin has full access.
model AdminUser {
  id                 String    @id @default(uuid()) @db.UniqueIdentifier
  email              String    @unique @db.NVarChar(256)
  passwordHash       String    @db.NVarChar(255)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  failedLoginCount   Int       @default(0)
  lockoutEnd         DateTime?
  lastLoginAt        DateTime?
  // Sessions issued before this are rejected
  passwordChangedAt  DateTime?
  createdAt          DateTime? @default(now())
  createdBy          String?   @db.UniqueIdentifier
  modifiedAt         DateTime? @updatedAt
  modifiedBy         String?   @db.UniqueIdentifier
}

// Append-only log of admin sign-ins and changes. createdBy = AdminUser.id (null for unknown emails / system)
model AdminAuditLog {
  id        BigInt   @id @default(autoincrement())
  action    String   @db.NVarChar(50)
  email     String?  @db.NVarChar(256)
  detail    String?  @db.NVarChar(500)
  createdAt DateTime @default(now())
  createdBy String?  @db.UniqueIdentifier

  @@index([createdAt(sort: Desc)])
}
